<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The Mac agent as a user LaunchAgent (docs/design/05-omb-mac-relay.md). Template: scripts/install-mac-agent.sh fills
  __BUN__, __REPO__, __MAC_HOME__ and __PATH__ and writes the result to ~/Library/LaunchAgents. Claude Code sessions run
  in tmux; AbandonProcessGroup keeps launchd from killing them with the agent, and the next agent picks them up.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.hannigan.mac-agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>__BUN__</string>
    <string>__REPO__/relay/mac-agent.ts</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HANNIGAN_MAC_HOME</key>
    <string>__MAC_HOME__</string>
    <key>PATH</key>
    <string>__PATH__</string>
    <key>LANG</key>
    <string>ja_JP.UTF-8</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ExitTimeOut</key>
  <integer>10</integer>
  <key>AbandonProcessGroup</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__MAC_HOME__/logs/agent.log</string>
  <key>StandardErrorPath</key>
  <string>__MAC_HOME__/logs/agent.log</string>
</dict>
</plist>
